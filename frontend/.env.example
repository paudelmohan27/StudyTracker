# Frontend environment variables
# Copy this file to .env and fill in your values.
# VITE_ variables are intentionally exposed to the browser; never place secrets here.

# Backend API URL (leave empty to use the Vite development proxy)
VITE_API_URL=http://localhost:5000

# Google OAuth browser client ID (public identifier, not a client secret)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_browser_client_id_here
